# webridge 本地开发环境配置示例
# 复制为 .env 后按实际情况修改，不要提交 .env 文件

# ── 服务端口 ──────────────────────────────────────────────
# webridge-server 监听的 HTTP 端口（nginx 反代到此）
PORT=3000

# ── 域名（用于生成链接、MCP 端点地址等）──────────────────
# 不含协议前缀，nginx 负责 TLS
WEBRIDGE_DOMAIN=webridge.example.com

# ── 数据目录 ──────────────────────────────────────────────
DB_PATH=/data/webridge.db
VAULT_PATH=/data/vault

# ── 主密钥（生产环境从 Docker secret 挂载，此处仅开发用）──
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 生产环境务必改为从文件读取，不要写在环境变量里
MASTER_KEY_HEX=

# ── 内部 RPC（server ↔ browser-worker）───────────────────
BROWSER_RPC_URL=http://browser:4000
BROWSER_RPC_SECRET=
# 浏览器 worker 自身监听端口与 profile 目录
BROWSER_RPC_PORT=4000
BROWSER_PROFILES_DIR=/profiles
# 出网代理（设计 §4.4.1：浏览器出网必须经过 egress-proxy）
BROWSER_EGRESS_PROXY=http://egress:3128
# egress 代理自身端口
EGRESS_PROXY_PORT=3128

# ── 后台认证（Passkey 依赖域名，必须与 nginx 访问域名一致）──
# WebAuthn RP ID 只填域名，不含协议与端口
WEBRIDGE_RP_ID=webridge.example.com
# 后台访问的完整 Origin，决定 cookie 是否加 Secure
WEBRIDGE_ORIGIN=https://webridge.example.com

# ── 前端静态资源 ─────────────────────────────────────────
# server 直接托管 apps/web 的构建产物；留空则不托管（由 nginx 单独托管）
WEB_ROOT=/app/apps/web/dist

# ── 连接器清单目录 ───────────────────────────────────────
CONNECTORS_DIR=/app/connectors

# ── 任务队列 ─────────────────────────────────────────────
TASK_WORKER_CONCURRENCY=4
TASK_MAX_RETRIES=3

# ── 邮件通知（SMTP）──────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=webridge@example.com

# ── 日志 ─────────────────────────────────────────────────
LOG_LEVEL=info

# ── 开发模式 ─────────────────────────────────────────────
NODE_ENV=development
