# owngate 本地开发环境配置示例
# 复制为 .env 后按实际情况修改，不要提交 .env 文件

# ── 服务端口 ──────────────────────────────────────────────
# owngate-server 监听的 HTTP 端口（nginx 反代到此）
PORT=3000
# 正式部署由宿主 nginx 提供 HTTPS；仅本机开放后台 HTTP。
# 需要局域网 IP 临时试用时，显式设置为对应局域网地址。
BIND_HOST=127.0.0.1

# ── 域名（用于生成链接、MCP 端点地址等）──────────────────
# 不含协议前缀，nginx 负责 TLS
OWNGATE_DOMAIN=owngate.example.com

# ── 数据目录 ──────────────────────────────────────────────
DB_PATH=/data/owngate.db

# ── 主密钥（生产环境从 Docker secret 挂载，此处仅开发用）──
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 生产环境务必改为从文件读取，不要写在环境变量里
MASTER_KEY_HEX=

# ── 内部 RPC（server ↔ browser-worker）───────────────────
# Compose 部署时 HMAC 密钥来自 deploy/secrets/browser_rpc_secret，地址、端口、
# 出网代理都由 docker-compose.yml 固定，这里无需填写。
# 仅在宿主机直接运行（不用 Docker）时取消注释：
# BROWSER_RPC_URL=http://127.0.0.1:4000
# BROWSER_RPC_SECRET=

# HTTP_RUNTIME_URL/HTTP_RUNTIME_SECRET_FILE/HTTP_BROKER_ORIGIN 由 Compose 固定。
# 在宿主机开发时使用本地子进程；正式部署使用无出网路由的 http-runtime 容器。

# ── 后台认证 ─────────────────────────────────────────────
# 后台访问的完整 Origin（协议 + 主机 + 端口），必须与浏览器地址栏一致。
# 以 https 开头时会话 cookie 加 Secure。
#   用 IP 试用：  OWNGATE_ORIGIN=http://192.168.x.x:3000
#   正式部署：    OWNGATE_ORIGIN=https://owngate.example.com
OWNGATE_ORIGIN=http://localhost:3000
# Passkey（WebAuthn）的 RP ID：只填域名，不含协议与端口。
# WebAuthn 不接受 IP 地址，且要求 HTTPS（localhost 例外）。用 IP 试用时
# Passkey 不可用，改用密码 + TOTP；配好域名后再填，并重新注册 Passkey。
OWNGATE_RP_ID=localhost

# ── 前端静态资源 ─────────────────────────────────────────
# server 直接托管 apps/web 的构建产物；留空则不托管（由 nginx 单独托管）
WEB_ROOT=/app/apps/web/dist

# ── 连接器清单目录 ───────────────────────────────────────
CONNECTORS_DIR=/app/connectors

# 邮件服务、UTC cron 与监控条件在后台「监控通知」配置，整体加密存储。
# 持久任务的并发、租约与只读恢复策略由服务内设置管理。

# ── 日志 ─────────────────────────────────────────────────
LOG_LEVEL=info

# ── 开发模式 ─────────────────────────────────────────────
NODE_ENV=development
