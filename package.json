{
  "name": "owngate",
  "version": "0.1.4",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @owngate/server dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "typecheck:tests": "node scripts/check-test-types.mjs",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
