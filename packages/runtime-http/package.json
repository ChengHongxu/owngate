{
  "name": "@owngate/runtime-http",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "exports": { ".": "./dist/index.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.adapters.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.adapters.json",
    "test": "vitest run",
    "start": "node dist/main.js",
    "clean": "rm -rf dist ../../connectors/paged-json-example/adapter.mjs ../../connectors/paged-json-example/adapter.mjs.map ../../connectors/paged-json-example/adapter.d.mts ../../connectors/paged-json-example/adapter.d.mts.map"
  },
  "dependencies": {
    "@owngate/core": "workspace:*",
    "@owngate/connector-runtime": "workspace:*"
  },
  "devDependencies": { "typescript": "^5.8.0", "vitest": "^3.2.0" }
}
