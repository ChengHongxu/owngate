{
  "name": "@owngate/db",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./worker": "./dist/worker.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/migrate.sql dist/migrate.sql",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.43.0",
    "@owngate/core": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
