# dependencies
node_modules/
.pnp
.pnp.js

# build outputs
dist/
dist-test/
build/
.next/
out/

# env & secrets — never commit these
.env
.env.*
!.env.example

# database & vault
*.db
*.db-journal
*.db-wal
*.db-shm
/vault/

# logs
*.log
logs/

# test coverage
coverage/
.nyc_output/

# IDE
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# pnpm
.pnpm-store/

# turbo cache
.turbo/

# playwright browsers (pulled at runtime inside Docker)
/playwright/.local-browsers/

# docker local overrides
deploy/docker-compose.override.yml

# docker secrets — master_key must never be committed
deploy/secrets/
!deploy/secrets/*.example
deploy/rekey/
/recovery-password

# TS build info
*.tsbuildinfo

