{
  "name": "@owngate/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --experimental-vm-modules dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/static": "^8.1.0",
    "@fastify/websocket": "^11.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@simplewebauthn/server": "^13.1.0",
    "@owngate/connector-runtime": "workspace:*",
    "@owngate/core": "workspace:*",
    "@owngate/db": "workspace:*",
    "@owngate/schema-meta": "workspace:*",
    "@owngate/runtime-http": "workspace:*",
    "@owngate/vault": "workspace:*",
    "ajv": "8.20.0",
    "argon2": "^0.43.0",
    "croner": "^11.0.0",
    "fastify": "^5.4.0",
    "nodemailer": "^6.10.0",
    "pino": "^9.7.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
